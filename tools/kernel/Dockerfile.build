# Native arm64 kernel build container. colima's docker context runs on an
# aarch64 VM on Apple Silicon, so this is a native build -- no cross
# toolchain needed for an arm64 target.
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        bc \
        bison \
        flex \
        libssl-dev \
        libelf-dev \
        ccache \
        cpio \
        rsync \
        curl \
        xz-utils \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ENV PATH="/usr/lib/ccache:${PATH}"
WORKDIR /kernel
