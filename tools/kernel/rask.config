# rask guest kernel config fragment (arm64, linux 6.6.x)
#
# Single source of truth for what rask's vz-guest kernel needs, on top of
# `make ARCH=arm64 defconfig`. Applied via
# scripts/kconfig/merge_config.sh -m .config rask.config && make olddefconfig
#
# Everything here is =y (built in): rask-init never loads kernel modules, so
# anything the guest needs at boot or during container-runtime operation must
# be compiled in rather than shipped as a .ko. CONFIG_MODULES itself is left
# untouched (defconfig default, =y) per the task brief ("modules support can
# stay =y but empty") -- we simply never run `make modules` or ship any .ko.
#
# Symbol names/requirements cross-checked against:
#  - spikes/s3/work/altkernel/boot/config-6.6.142-0-virt: Alpine linux-virt
#    6.6.142-0-virt's actual .config, the exact kernel S3 validated
#    end-to-end (containerd + Rosetta + amd64 image run under vz). Anything
#    that was =m there and is needed for boot/runtime is flipped to =y here.
#  - spikes/s3/RESULTS.md "production recipe" module list (rng-core,
#    virtio-rng, af_packet, failover, net_failover, virtio_net, fuse,
#    virtiofs, binfmt_misc, overlay).
#  - task brief's k8s-node feature list (CGROUPS v2, netfilter/iptables set
#    for kube-proxy + CNI portmap, namespaces, vsock, EROFS, etc).

# --- virtio transport + devices (all =y, vz uses virtio-pci; MMIO unused --
#     Alpine's config leaves VIRTIO_MMIO=m and still boots under vz) ---
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_PCI_LEGACY=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_FS=y
CONFIG_FUSE_FS=y
CONFIG_VIRTIO_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS_COMMON=y
CONFIG_VSOCKETS=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y
# SoC-specific RNG drivers are irrelevant under vz's virtual platform.
# CONFIG_HW_RANDOM_CAVIUM is not set
# CONFIG_HW_RANDOM_CN10K is not set
# CONFIG_HW_RANDOM_HISI is not set
# CONFIG_HW_RANDOM_HISTB is not set
# CONFIG_HW_RANDOM_XGENE is not set
# CONFIG_HW_RANDOM_ARM_SMCCC_TRNG is not set
CONFIG_FAILOVER=y
CONFIG_NET_FAILOVER=y

# --- root/container filesystems ---
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_POSIX_ACL=y
CONFIG_EROFS_FS_SECURITY=y
CONFIG_OVERLAY_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y

# --- Rosetta / amd64 binary support (S3) ---
CONFIG_BINFMT_MISC=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y

# --- namespaces (full set for a k8s node / pod sandboxing) ---
CONFIG_NAMESPACES=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y

# --- cgroups v2, complete controller set kubelet/containerd need ---
CONFIG_CGROUPS=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CPUSETS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_HUGETLB=y
CONFIG_MEMCG=y
CONFIG_MEMCG_KMEM=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_BPF=y
CONFIG_CGROUP_PERF=y
CONFIG_CGROUP_NET_CLASSID=y
CONFIG_CGROUP_NET_PRIO=y
CONFIG_CGROUP_WRITEBACK=y

# --- netfilter / iptables set kube-proxy (iptables mode) + CNI bridge+portmap need ---
# IPV6=y (built in, not =m) is required here: BRIDGE and IP6_NF_IPTABLES
# both have Kconfig deps of the form "depends on IPV6" and a built-in
# symbol cannot depend on a module -- verified by a config-only dry run
# (defconfig+merge_config+olddefconfig, no compile) against arm64 defconfig,
# which defaults IPV6=m; without this override BRIDGE/BRIDGE_NETFILTER/
# IP6_NF_*/NETFILTER_XT_MATCH_PHYSDEV all silently got capped back to =m
# by olddefconfig despite being requested =y in the fragment.
CONFIG_IPV6=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_CONNTRACK_MARK=y
CONFIG_NF_CONNTRACK_EVENTS=y
CONFIG_NF_NAT=y
CONFIG_NF_NAT_MASQUERADE=y
CONFIG_NF_NAT_REDIRECT=y
CONFIG_NETFILTER_XT_NAT=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_STATE=y
CONFIG_NETFILTER_XT_MATCH_MARK=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
CONFIG_NETFILTER_XT_MATCH_PHYSDEV=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_TARGET_REDIRECT=y
CONFIG_NETFILTER_XT_TARGET_MARK=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_MANGLE=y
CONFIG_IP_NF_RAW=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP_NF_TARGET_REDIRECT=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_MANGLE=y
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_NETFILTER_FAMILY_BRIDGE=y
CONFIG_VETH=y

# --- packet/vsock/misc kubelet & runtime needs ---
CONFIG_PACKET=y
CONFIG_TMPFS_INODE64=y
CONFIG_INOTIFY_USER=y
CONFIG_POSIX_MQUEUE=y

# --- aggressively disable what a headless k8s-node microVM never touches ---
# CONFIG_SOUND is not set
# CONFIG_DRM is not set
# CONFIG_FB is not set
# CONFIG_USB_SUPPORT is not set
# CONFIG_WLAN is not set
# CONFIG_CFG80211 is not set
# CONFIG_BT is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_MTD is not set
# CONFIG_INFINIBAND is not set
# CONFIG_STAGING is not set
