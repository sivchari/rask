/rask-init

# placeholder (see that package's doc comment); `make build-rask-init`
# overwrites it locally with a real ~40MB cross-compiled binary, which
# should never itself be committed.
/test/benchmark/.raw-durations-*.txt
/test/benchmark/.incontainer/
test/benchmark/*.md

# `make bundle-payload` (cmd/bundle-payload) stages the real payload here —
# potentially gigabytes of downloaded component binaries plus manifest.json
# — never committed, exactly like /rask-init above (see
# internal/components/bundlepayload's package doc). Only .gitkeep (keeping
# the directory present so a fresh checkout has somewhere to stage into) is
# tracked.
/internal/components/bundlepayload/payload/*
!/internal/components/bundlepayload/payload/.gitkeep
PROGRESS-*.md
