plan-*.md
research-*.md
/bin/
/dist/
*.qcow2
*.img
*.erofs
/spikes/**/work/
go.work
go.work.sum
/spikes/s1/spike-s1
/spikes/s1/seed/
/tools/kernel/work/
/rask.linux-*
